---
import HeroBackground from "../backgrounds/HeroBackground.astro";

interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  secondaryDescription?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  title,
  highlight,
  description,
  secondaryDescription,
  primaryLabel,
  primaryHref = "#",
  secondaryLabel,
  secondaryHref = "#",
} = Astro.props;
---

<HeroBackground>
  <section class="hero section">
    <div class="container hero-grid">
      <div class="hero-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}

        <h1 class="hero-title">
          <span class="hero-title-primary">
            <span class="hero-title-base">Phey</span>
            <span class="hero-title-accent">Rainville</span>
          </span>
          {highlight && <span class="hero-title-studio">{highlight}</span>}
        </h1>

        {description && (
          <p class="hero-description">
            {description.includes(",") ? (
              <>
                {description.slice(0, description.indexOf(",") + 1)}
                <br />
                {description.slice(description.indexOf(",") + 2)}
              </>
            ) : (
              description
            )}
          </p>
        )}
        {secondaryDescription && (
          <p class="hero-description hero-description-secondary">
            {secondaryDescription}
          </p>
        )}

        <div class="hero-actions">
          {primaryLabel && (
            <a class="button button-primary" href={primaryHref}>{primaryLabel}</a>
          )}

          {secondaryLabel && (
            <a class="button button-secondary" href={secondaryHref}>
              {secondaryLabel}
            </a>
          )}
        </div>
      </div>

      <div class="hero-visual-slot" aria-hidden="true" hidden></div>
    </div>
  </section>
</HeroBackground>
