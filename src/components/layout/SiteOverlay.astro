---
interface Props {
  overlayId: string;
  closeLabel?: string;
  label?: string;
  titleId?: string;
  panelClass?: string;
  contentClass?: string;
  overlayClass?: string;
  backdropClass?: string;
}

const {
  overlayId,
  closeLabel = "Fermer la fenêtre",
  label,
  titleId,
  panelClass,
  contentClass,
  overlayClass,
  backdropClass,
} = Astro.props;
---

<div
  class:list={["site-overlay", overlayClass]}
  data-site-overlay={overlayId}
  hidden
>
  <div
    class:list={["site-overlay-backdrop", backdropClass]}
    data-site-overlay-close
  ></div>

  <div
    class:list={["site-overlay-panel", "glass-panel", panelClass]}
    role="dialog"
    aria-modal="true"
    aria-labelledby={titleId}
    aria-label={titleId ? undefined : label}
    tabindex="-1"
  >
    <button
      class="site-overlay-close"
      type="button"
      aria-label={closeLabel}
      data-site-overlay-close
    >
      ×
    </button>

    <div class:list={["site-overlay-content", contentClass]}>
      <slot />
    </div>
  </div>
</div>

<script>
  const initSiteOverlays = () => {
    if (window.__siteOverlayInitialized) return;
    window.__siteOverlayInitialized = true;

    const lastTriggerByOverlay = new WeakMap();

    const getOverlay = (overlayId) => {
      const overlay = document.querySelector(`[data-site-overlay="${overlayId}"]`);
      return overlay instanceof HTMLElement ? overlay : null;
    };

    const syncBodyLock = () => {
      const hasVisibleOverlay = Array.from(
        document.querySelectorAll("[data-site-overlay]"),
      ).some((overlay) => overlay instanceof HTMLElement && !overlay.hidden);

      document.body.classList.toggle("overlay-open", hasVisibleOverlay);
    };

    const openOverlay = (overlay, trigger) => {
      overlay.hidden = false;
      if (trigger instanceof HTMLElement) {
        lastTriggerByOverlay.set(overlay, trigger);
      }

      syncBodyLock();

      const closeButton = overlay.querySelector("[data-site-overlay-close]");
      if (closeButton instanceof HTMLElement) {
        closeButton.focus();
        return;
      }

      const panel = overlay.querySelector(".site-overlay-panel");
      if (panel instanceof HTMLElement) {
        panel.focus();
      }
    };

    const closeOverlay = (overlay) => {
      overlay.hidden = true;
      syncBodyLock();

      const lastTrigger = lastTriggerByOverlay.get(overlay);
      if (lastTrigger instanceof HTMLElement) {
        lastTrigger.focus();
      }
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const opener = target.closest("[data-site-overlay-open]");
      if (opener instanceof HTMLElement) {
        const overlayId = opener.dataset.siteOverlayOpen;
        if (!overlayId) return;

        const overlay = getOverlay(overlayId);
        if (!overlay) return;

        event.preventDefault();
        openOverlay(overlay, opener);
        return;
      }

      const closer = target.closest("[data-site-overlay-close]");
      if (!(closer instanceof HTMLElement)) return;

      const overlay = closer.closest("[data-site-overlay]");
      if (!(overlay instanceof HTMLElement)) return;

      event.preventDefault();
      closeOverlay(overlay);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;

      const overlays = Array.from(document.querySelectorAll("[data-site-overlay]"))
        .filter((overlay) => overlay instanceof HTMLElement && !overlay.hidden);
      const lastOverlay = overlays.at(-1);

      if (!(lastOverlay instanceof HTMLElement)) return;

      closeOverlay(lastOverlay);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSiteOverlays, { once: true });
  } else {
    initSiteOverlays();
  }
</script>
