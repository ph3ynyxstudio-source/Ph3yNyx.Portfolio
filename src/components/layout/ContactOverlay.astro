---
import SiteOverlay from "./SiteOverlay.astro";
---

<SiteOverlay
  overlayId="contact"
  titleId="contact-overlay-title"
  closeLabel="Fermer le contact"
  panelClass="contact-overlay-panel"
  contentClass="contact-overlay-content"
>
  <p id="contact-overlay-title" class="eyebrow">Entrer en contact</p>
  <p class="section-intro">
    Pour un besoin, une collaboration, une question ou une offre de travail, contacte-moi directement par courriel.
  </p>

  <p class="contact-overlay-email">
    Courriel : <a href="mailto:phey.rainville@hotmail.com">phey.rainville@hotmail.com</a>
  </p>

  <form class="contact-overlay-form" data-contact-form>
    <label>
      <span>Ton courriel</span>
      <input
        type="email"
        name="email"
        placeholder="toncourriel@exemple.com"
        required
      />
    </label>

    <label>
      <span>Message</span>
      <textarea
        name="message"
        rows="6"
        placeholder="Présente brièvement ton besoin, ton projet ou ton opportunité."
        required
      ></textarea>
    </label>

    <div class="contact-overlay-actions">
      <button class="button button-primary" type="submit">Envoyer</button>
      <button class="button button-secondary" type="button" data-site-overlay-close>
        Fermer
      </button>
    </div>
  </form>
</SiteOverlay>

<script>
  const initContactOverlay = () => {
    const overlay = document.querySelector('[data-site-overlay="contact"]');
    const form = document.querySelector("[data-contact-form]");

    if (!(overlay instanceof HTMLElement)) return;
    if (overlay.dataset.initialized === "true") return;
    overlay.dataset.initialized = "true";

    if (form instanceof HTMLFormElement) {
      form.addEventListener("submit", (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const email = String(formData.get("email") ?? "").trim();
        const message = String(formData.get("message") ?? "").trim();
        const body = encodeURIComponent(
          `Courriel : ${email}\n\nMessage :\n${message}`,
        );
        const subject = encodeURIComponent("Prise de contact via Ph3yNyx.Studio");

        window.location.href =
          `mailto:phey.rainville@hotmail.com?subject=${subject}&body=${body}`;
      });
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContactOverlay, { once: true });
  } else {
    initContactOverlay();
  }
</script>
