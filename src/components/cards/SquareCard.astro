---
interface Props {
  number?: string;
  title: string;
  description?: string;
  tags?: string[];
  href?: string;
  icon?: string;
}

const {
  number,
  title,
  description,
  tags = [],
  href,
  icon = "✦",
} = Astro.props;

const Tag = href ? "a" : "article";
---

<Tag class="square-card glass-panel" href={href}>
  <div class="square-card-top">
    <span class="square-card-icon" aria-hidden="true">{icon}</span>
    {number && <span class="square-card-number">{number}</span>}
  </div>

  <div class="square-card-body">
    <h3>{title}</h3>
    {description && <p>{description}</p>}
  </div>

  {tags.length > 0 && (
    <div class="square-card-tags" aria-label="Technologies">
      {tags.map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</Tag>
