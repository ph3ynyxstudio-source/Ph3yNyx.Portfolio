---
import PageShell from "../layout/PageShell.astro";
---

<PageShell id="contact">
  <div class="contact-panel glass-panel">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Parlons d’un outil, d’un MVP ou d’une refonte propre.</h2>
      <p class="section-intro">
        Une discussion simple suffit pour cadrer un besoin et voir ce qu’on peut
        construire.
      </p>
    </div>

    <button class="button button-primary" type="button" data-contact-open>
      Me contacter
    </button>
  </div>
</PageShell>
