---
import PageShell from "../layout/PageShell.astro";
import ServiceCard from "../cards/ServiceCard.astro";
import { services } from "../../data/services";
---

<PageShell id="services">
  <div class="section-heading">
    <p class="eyebrow">Services</p>
    <h2>Des bases solides pour faire avancer un projet.</h2>
    <p class="section-intro">
      J’aide a structurer, prototyper et rendre plus lisibles des produits
      numeriques utiles.
    </p>
  </div>

  <div class="card-grid">
    {services.map((service) => (
      <ServiceCard {...service} />
    ))}
  </div>
</PageShell>
