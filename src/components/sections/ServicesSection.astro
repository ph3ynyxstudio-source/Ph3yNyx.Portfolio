---
import PageShell from "../layout/PageShell.astro";
import ServiceCard from "../cards/ServiceCard.astro";
import { services } from "../../data/services";
---

<PageShell id="services">
  <div class="section-heading">
    <p class="eyebrow">Services</p>
    <h2>Services et competences observables.</h2>
    <p class="section-intro">
      Des briques de travail concretes pour prototyper, structurer et faire
      evoluer un produit numerique plus sereinement.
    </p>
  </div>

  <div class="card-grid">
    {services.map((service) => (
      <ServiceCard {...service} />
    ))}
  </div>
</PageShell>
