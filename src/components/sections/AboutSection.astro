---
import PageShell from "../layout/PageShell.astro";
---

<PageShell id="apropos">
  <div class="section-heading">
    <p class="eyebrow">Accueil / À propos</p>
    <h2>Des outils locaux pour organiser, documenter et reprendre plus vite.</h2>
    <p class="section-intro">
      À travers mes projets, je construis des outils concrets, progressifs et
      documentés pour transformer des idées en applications utiles.
    </p>
  </div>

  <div class="card-grid about-grid">
    <article class="glass-panel prose-block about-card-detail">
      <div class="about-card-body">
        <p class="eyebrow">Présentation</p>
        <p class="about-card-copy">
          Curieux des systèmes numériques, je construis des outils locaux et
          pratiques à partir de besoins réels.
        </p>
      </div>
      <div class="about-card-action">
        <button
          class="about-card-button"
          type="button"
          data-about-open="presentation"
          aria-haspopup="dialog"
        >
          Lire la suite
        </button>
      </div>
    </article>

    <article class="glass-panel prose-block about-card-detail">
      <div class="about-card-body">
        <p class="eyebrow">Méthode</p>
        <div class="about-method-inline" aria-label="Résumé de la méthode">
          <p>Clarifier d’abord.</p>
          <p>Construire ensuite.</p>
        </div>
        <p class="about-card-copy">
          J’utilise l’IA comme assistant de réflexion et Chr0nosV3rs pour
          documenter ma progression.
        </p>
      </div>
      <div class="about-card-action">
        <button
          class="about-card-button"
          type="button"
          data-about-open="methode"
          aria-haspopup="dialog"
        >
          Lire la suite
        </button>
      </div>
    </article>

    <article class="glass-panel prose-block about-card-detail">
      <div class="about-card-body">
        <p class="eyebrow">Compétences observables</p>
        <div class="about-tags">
          <span class="tag">React</span>
          <span class="tag">TypeScript</span>
          <span class="tag">Tauri</span>
          <span class="tag">Rust</span>
          <span class="tag">Flutter</span>
        </div>
        <p class="about-card-copy">
          J’utilise ces outils pour construire des interfaces, des prototypes
          et des applications locales documentées.
        </p>
      </div>
      <div class="about-card-action">
        <button
          class="about-card-button"
          type="button"
          data-about-open="competences"
          aria-haspopup="dialog"
        >
          Lire la suite
        </button>
      </div>
    </article>
  </div>

  <div class="about-overlay" data-about-overlay="presentation" hidden>
    <div class="about-overlay-backdrop" data-about-close></div>
    <div
      class="about-overlay-panel glass-panel"
      role="dialog"
      aria-modal="true"
      aria-label="Présentation"
    >
      <button
        class="about-overlay-close"
        type="button"
        aria-label="Fermer la présentation"
        data-about-close
      >
        ×
      </button>

      <div class="about-overlay-content">
        <p class="eyebrow">Présentation</p>
        <p>
          Curieux des systèmes numériques depuis longtemps, j’ai commencé à
          coder en 2026 à partir d’un besoin réel.
        </p>
        <p>
          Depuis, je construis des outils locaux, pratiques et pensés pour
          aider à mieux organiser, documenter et comprendre.
        </p>
      </div>
    </div>
  </div>

  <div class="about-overlay" data-about-overlay="methode" hidden>
    <div class="about-overlay-backdrop" data-about-close></div>
    <div
      class="about-overlay-panel glass-panel"
      role="dialog"
      aria-modal="true"
      aria-label="Méthode"
    >
      <button
        class="about-overlay-close"
        type="button"
        aria-label="Fermer la méthode"
        data-about-close
      >
        ×
      </button>

      <div class="about-overlay-content">
        <p class="eyebrow">Méthode</p>
        <div class="about-method-inline" aria-label="Méthode complète">
          <p>Clarifier d’abord.</p>
          <p>Construire ensuite.</p>
        </div>
        <p>
          J’utilise l’IA comme assistant de réflexion pour clarifier mes idées,
          structurer mes projets et avancer plus efficacement.
        </p>
        <p>
          Avec Chr0nosV3rs, je documente mes sessions, mes blocages et ma
          progression pour garder une méthode de travail claire.
        </p>
      </div>
    </div>
  </div>

  <div class="about-overlay" data-about-overlay="competences" hidden>
    <div class="about-overlay-backdrop" data-about-close></div>
    <div
      class="about-overlay-panel glass-panel"
      role="dialog"
      aria-modal="true"
      aria-label="Compétences observables"
    >
      <button
        class="about-overlay-close"
        type="button"
        aria-label="Fermer les compétences observables"
        data-about-close
      >
        ×
      </button>

      <div class="about-overlay-content">
        <p class="eyebrow">Compétences observables</p>
        <div class="about-skills-scroll">
          <div class="about-skills-stack">
            <section class="about-skill-block">
              <h3>Interfaces web</h3>
              <p class="about-skill-tools">React · TypeScript</p>
              <p>Créer des interfaces web structurées et évolutives.</p>
            </section>

            <section class="about-skill-block">
              <h3>Applications locales</h3>
              <p class="about-skill-tools">Tauri · Rust</p>
              <p>Explorer des outils desktop locaux, légers et documentés.</p>
            </section>

            <section class="about-skill-block">
              <h3>Mobile</h3>
              <p class="about-skill-tools">Flutter</p>
              <p>Travailler des interfaces mobiles et multiplateformes.</p>
            </section>

            <section class="about-skill-block">
              <h3>Documentation</h3>
              <p class="about-skill-tools">GitHub · Obsidian · Chr0nosV3rs</p>
              <p>Suivre, documenter et reprendre les projets plus facilement.</p>
            </section>

            <section class="about-skill-block">
              <h3>IA comme assistant</h3>
              <p class="about-skill-tools">ChatGPT · Codex</p>
              <p>
                Clarifier, structurer et aider au développement sans remplacer
                la décision humaine.
              </p>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</PageShell>

<style>
  .about-card-detail {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    gap: 1rem;
  }

  .about-card-body {
    display: grid;
    gap: 1rem;
    flex: 1;
    min-width: 0;
    align-content: start;
  }

  .about-card-action {
    margin-top: auto;
    display: flex;
    align-items: flex-start;
  }

  .about-grid .prose-block {
    min-width: 0;
    overflow: hidden;
  }

  .about-grid .eyebrow,
  .about-grid p,
  .about-overlay-content p {
    max-width: 32rem;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .about-grid .eyebrow {
    margin-bottom: 0;
    line-height: 1.35;
  }

  .about-grid p,
  .about-overlay-content p {
    line-height: 1.65;
  }

  .about-card-copy {
    color: var(--color-muted);
  }

  .about-method-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    align-items: baseline;
    max-width: 32rem;
  }

  .about-method-inline p {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.45;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    width: 100%;
    max-width: 100%;
  }

  .about-tags .tag {
    padding: 0.3rem 0.52rem;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .about-card-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.35rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid rgba(126, 239, 255, 0.22);
    border-radius: 999px;
    background: rgba(84, 214, 255, 0.06);
    color: var(--color-cyan-bright);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .about-card-button:hover {
    transform: translateY(-1px);
    border-color: var(--color-border-strong);
    background: rgba(84, 214, 255, 0.1);
    box-shadow: 0 0 20px rgba(84, 214, 255, 0.14);
  }

  .about-card-button:focus-visible {
    outline: 1px solid rgba(126, 239, 255, 0.55);
    outline-offset: 2px;
  }

  .about-overlay {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .about-overlay[hidden] {
    display: none !important;
  }

  .about-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(1, 3, 10, 0.78);
    backdrop-filter: blur(10px);
  }

  .about-overlay-panel {
    position: relative;
    z-index: 1;
    width: min(100%, 560px);
    padding: 1.5rem;
    max-height: min(80vh, 720px);
  }

  .about-overlay-close {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 999px;
    background: rgba(84, 214, 255, 0.08);
    color: var(--color-text);
    cursor: pointer;
    font-size: 1.2rem;
  }

  .about-overlay-content {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }

  .about-skills-scroll {
    max-height: calc(min(80vh, 720px) - 12.25rem);
    overflow-y: auto;
    padding-right: 0.2rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(84, 214, 255, 0.45) transparent;
  }

  .about-skills-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .about-skills-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .about-skills-scroll::-webkit-scrollbar-thumb {
    background: rgba(84, 214, 255, 0.45);
    border-radius: 999px;
  }

  .about-skills-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(84, 214, 255, 0.75);
  }

  .about-skills-stack {
    display: grid;
    gap: 0.85rem;
  }

  .about-skill-block {
    display: grid;
    gap: 0.45rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid rgba(126, 239, 255, 0.14);
    border-radius: 14px;
    background: rgba(84, 214, 255, 0.04);
  }

  .about-skill-block h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  .about-skill-tools {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.28rem 0.6rem;
    border: 1px solid rgba(126, 239, 255, 0.16);
    border-radius: 999px;
    background: rgba(84, 214, 255, 0.06);
    color: var(--color-cyan-bright);
    font-size: 0.74rem;
    line-height: 1.2;
  }

  @media (max-width: 640px) {
    .about-card-detail {
      gap: 0.9rem;
      padding: 1.35rem;
    }

    .about-overlay-panel {
      width: min(100%, 640px);
      padding: 1.5rem;
      max-height: 82vh;
    }

    .about-skills-scroll {
      max-height: calc(82vh - 11.25rem);
    }
  }
</style>

<script>
  const overlays = document.querySelectorAll("[data-about-overlay]");

  overlays.forEach((overlay) => {
    if (!(overlay instanceof HTMLElement)) return;
    if (overlay.dataset.initialized === "true") return;
    overlay.dataset.initialized = "true";

    const overlayId = overlay.dataset.aboutOverlay;
    const trigger = document.querySelector(`[data-about-open="${overlayId}"]`);
    const closeButtons = overlay.querySelectorAll("[data-about-close]");

    const openOverlay = () => {
      overlay.hidden = false;
      document.body.classList.add("contact-overlay-open");
    };

    const closeOverlay = () => {
      overlay.hidden = true;
      document.body.classList.remove("contact-overlay-open");
    };

    trigger?.addEventListener("click", openOverlay);

    closeButtons.forEach((button) => {
      button.addEventListener("click", closeOverlay);
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !overlay.hidden) {
        closeOverlay();
      }
    });
  });
</script>
