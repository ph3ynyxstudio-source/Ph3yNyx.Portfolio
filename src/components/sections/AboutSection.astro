---
import PageShell from "../layout/PageShell.astro";
import SiteOverlay from "../layout/SiteOverlay.astro";
---

<PageShell id="apropos">
  <div class="section-heading">
    <p class="eyebrow">Accueil / À propos</p>
    <h2>Des outils locaux pour organiser, documenter et reprendre plus vite.</h2>
    <p class="section-intro">
      À travers mes projets, je construis des outils concrets, progressifs et
      documentés pour transformer des idées en applications utiles.
    </p>
  </div>

  <div class="card-grid about-grid">
    <article class="glass-panel prose-block about-card-detail">
      <div class="about-card-body">
        <p class="eyebrow">Présentation</p>
        <p class="about-card-copy">
          Curieux des systèmes numériques, je construis des outils locaux et
          pratiques à partir de besoins réels.
        </p>
      </div>
      <div class="about-card-action">
        <button
          class="about-card-button"
          type="button"
          data-site-overlay-open="presentation"
          aria-haspopup="dialog"
        >
          Lire la suite
        </button>
      </div>
    </article>

    <article class="glass-panel prose-block about-card-detail">
      <div class="about-card-body">
        <p class="eyebrow">Méthode</p>
        <div class="about-method-inline" aria-label="Résumé de la méthode">
          <p>Clarifier d’abord.</p>
          <p>Construire ensuite.</p>
        </div>
        <p class="about-card-copy">
          J’utilise l’IA comme assistant de réflexion et Chr0nosV3rs pour
          documenter ma progression.
        </p>
      </div>
      <div class="about-card-action">
        <button
          class="about-card-button"
          type="button"
          data-site-overlay-open="methode"
          aria-haspopup="dialog"
        >
          Lire la suite
        </button>
      </div>
    </article>

    <article class="glass-panel prose-block about-card-detail">
      <div class="about-card-body">
        <p class="eyebrow">Compétences observables</p>
        <div class="about-tags">
          <span class="tag">React</span>
          <span class="tag">TypeScript</span>
          <span class="tag">Tauri</span>
          <span class="tag">Rust</span>
          <span class="tag">Flutter</span>
        </div>
        <p class="about-card-copy">
          J’utilise ces outils pour construire des interfaces, des prototypes
          et des applications locales documentées.
        </p>
      </div>
      <div class="about-card-action">
        <button
          class="about-card-button"
          type="button"
          data-site-overlay-open="competences"
          aria-haspopup="dialog"
        >
          Lire la suite
        </button>
      </div>
    </article>
  </div>

  <SiteOverlay
    overlayId="presentation"
    titleId="about-overlay-title-presentation"
    closeLabel="Fermer la présentation"
    overlayClass="about-overlay"
    backdropClass="about-overlay-backdrop"
    panelClass="about-overlay-panel"
    contentClass="about-overlay-content"
  >
    <p id="about-overlay-title-presentation" class="eyebrow">Présentation</p>
    <p>
      Curieux des systèmes numériques depuis longtemps, j’ai commencé à coder
      en 2026 à partir d’un besoin réel.
    </p>
    <p>
      Depuis, je construis des outils locaux, pratiques et pensés pour aider à
      mieux organiser, documenter et comprendre.
    </p>
  </SiteOverlay>

  <SiteOverlay
    overlayId="methode"
    titleId="about-overlay-title-methode"
    closeLabel="Fermer la méthode"
    overlayClass="about-overlay"
    backdropClass="about-overlay-backdrop"
    panelClass="about-overlay-panel"
    contentClass="about-overlay-content"
  >
    <p id="about-overlay-title-methode" class="eyebrow">Méthode</p>
    <div class="about-method-inline" aria-label="Méthode complète">
      <p>Clarifier d’abord.</p>
      <p>Construire ensuite.</p>
    </div>
    <p>
      J’utilise l’IA comme assistant de réflexion pour clarifier mes idées,
      structurer mes projets et avancer plus efficacement.
    </p>
    <p>
      Avec Chr0nosV3rs, je documente mes sessions, mes blocages et ma
      progression pour garder une méthode de travail claire.
    </p>
  </SiteOverlay>

  <SiteOverlay
    overlayId="competences"
    titleId="about-overlay-title-competences"
    closeLabel="Fermer les compétences observables"
    overlayClass="about-overlay"
    backdropClass="about-overlay-backdrop"
    panelClass="about-overlay-panel"
    contentClass="about-overlay-content"
  >
    <p id="about-overlay-title-competences" class="eyebrow">Compétences observables</p>
    <div class="about-skills-scroll">
      <div class="about-skills-stack">
        <section class="about-skill-block">
          <h3>Interfaces web</h3>
          <p class="about-skill-tools">React · TypeScript</p>
          <p>Créer des interfaces web structurées et évolutives.</p>
        </section>

        <section class="about-skill-block">
          <h3>Applications locales</h3>
          <p class="about-skill-tools">Tauri · Rust</p>
          <p>Explorer des outils desktop locaux, légers et documentés.</p>
        </section>

        <section class="about-skill-block">
          <h3>Mobile</h3>
          <p class="about-skill-tools">Flutter</p>
          <p>Travailler des interfaces mobiles et multiplateformes.</p>
        </section>

        <section class="about-skill-block">
          <h3>Documentation</h3>
          <p class="about-skill-tools">GitHub · Obsidian · Chr0nosV3rs</p>
          <p>Suivre, documenter et reprendre les projets plus facilement.</p>
        </section>

        <section class="about-skill-block">
          <h3>IA comme assistant</h3>
          <p class="about-skill-tools">ChatGPT · Codex</p>
          <p>
            Clarifier, structurer et aider au développement sans remplacer la
            décision humaine.
          </p>
        </section>
      </div>
    </div>
  </SiteOverlay>
</PageShell>

<style>
  .about-card-detail {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    gap: 1rem;
  }

  .about-card-body {
    display: grid;
    gap: 1rem;
    flex: 1;
    min-width: 0;
    align-content: start;
  }

  .about-card-action {
    margin-top: auto;
    display: flex;
    align-items: flex-start;
  }

  .about-grid .prose-block {
    min-width: 0;
    overflow: hidden;
  }

  .about-grid .eyebrow,
  .about-grid p,
  .about-overlay-content p {
    max-width: 32rem;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .about-grid .eyebrow {
    margin-bottom: 0;
    line-height: 1.35;
  }

  .about-grid p,
  .about-overlay-content p {
    line-height: 1.65;
  }

  .about-card-copy {
    color: var(--color-card-body-text);
  }

  .about-method-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.9rem;
    align-items: baseline;
    max-width: 32rem;
  }

  .about-method-inline p {
    color: var(--color-card-title-text);
    font-weight: 600;
    line-height: 1.45;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    width: 100%;
    max-width: 100%;
  }

  .about-tags .tag {
    padding: 0.3rem 0.52rem;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .about-card-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.35rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--color-accent-border-strong);
    border-radius: 999px;
    background: var(--color-accent-surface-soft);
    color: var(--color-card-accent-text);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .about-card-button:hover {
    transform: translateY(-1px);
    border-color: var(--color-border-strong);
    background: var(--color-accent-surface-strong);
    box-shadow: 0 0 20px var(--color-toggle-shadow);
  }

  .about-card-button:focus-visible {
    outline: 1px solid var(--color-border-strong);
    outline-offset: 2px;
  }

  .about-overlay-backdrop {
    background: var(--color-about-overlay-backdrop);
    backdrop-filter: blur(6px);
  }

  .about-overlay-panel {
    max-height: min(80vh, 720px);
  }

  .about-skills-scroll {
    max-height: calc(min(80vh, 720px) - 12.25rem);
    overflow-y: auto;
    padding-right: 0.2rem;
    scrollbar-width: thin;
    scrollbar-color: var(--hero-accent-line-end) transparent;
  }

  .about-skills-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .about-skills-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .about-skills-scroll::-webkit-scrollbar-thumb {
    background: var(--hero-accent-line-end);
    border-radius: 999px;
  }

  .about-skills-scroll::-webkit-scrollbar-thumb:hover {
    background: var(--color-cyan);
  }

  .about-skills-stack {
    display: grid;
    gap: 0.85rem;
  }

  .about-skill-block {
    display: grid;
    gap: 0.45rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--color-accent-border-soft);
    border-radius: 14px;
    background: var(--color-accent-surface-subtle);
  }

  .about-skill-block h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--color-text);
  }

  .about-skill-tools {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 999px;
    background: var(--color-accent-surface-soft);
    color: var(--color-cyan-bright);
    font-size: 0.74rem;
    line-height: 1.2;
  }

  @media (max-width: 640px) {
    .about-card-detail {
      gap: 0.9rem;
      padding: 1.35rem;
    }

    .about-overlay-panel {
      width: min(100%, 640px);
      padding: 1.5rem;
      max-height: 82vh;
    }

    .about-skills-scroll {
      max-height: calc(82vh - 11.25rem);
    }
  }
</style>

