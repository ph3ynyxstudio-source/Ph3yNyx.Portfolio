---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ContactOverlay from "../components/layout/ContactOverlay.astro";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ph3yNyx.Studio",
  description = "Portfolio developpeur et studio d’outils numeriques local-first.",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const faviconSvg = `${baseUrl}images/logo-ph3ynyx-studio.svg`;
const faviconPng = `${baseUrl}images/logo-ph3ynyx-studio.png`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" href={faviconPng} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ContactOverlay />
  </body>
</html>
