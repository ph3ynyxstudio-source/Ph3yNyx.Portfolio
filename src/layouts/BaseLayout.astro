---
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import ContactOverlay from "../components/layout/ContactOverlay.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import { assetPath } from "../utils/base-path";

interface Props {
  title?: string;
  description?: string;
  lang?: "fr" | "en";
  canonicalHref?: string;
  alternateHrefLangs?: Array<{
    lang: string;
    href: string;
  }>;
}

const {
  title = "Ph3yNyx.Studio",
  description = "Portfolio developpeur et studio d’outils numeriques local-first.",
  lang = "fr",
  canonicalHref,
  alternateHrefLangs = [],
} = Astro.props;

const faviconSvg = assetPath("images/logo-ph3ynyx-studio.svg");
const faviconPng = assetPath("images/logo-ph3ynyx-studio.png");
const heroBackgroundImage = `url("${assetPath("Hero.webp")}")`;
const sectionBackgroundImage = `url("${assetPath("Mur.webp")}")`;
const themeStorageKey = "ph3ynyx-theme";
---

<!doctype html>
<html
  lang={lang}
  style={`--hero-bg-image: ${heroBackgroundImage}; --section-bg-image: ${sectionBackgroundImage};`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {alternateHrefLangs.map(({ lang: hrefLang, href }) => (
      <link rel="alternate" hreflang={hrefLang} href={href} />
    ))}
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" type="image/png" href={faviconPng} />
    <script is:inline define:vars={{ themeStorageKey }}>
      (() => {
        const validThemes = new Set(["dark", "sun"]);
        let theme = "dark";

        try {
          const storedTheme = window.localStorage.getItem(themeStorageKey);
          if (storedTheme && validThemes.has(storedTheme)) {
            theme = storedTheme;
          }
        } catch {
          theme = "dark";
        }

        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <ContactOverlay />
  </body>
</html>
