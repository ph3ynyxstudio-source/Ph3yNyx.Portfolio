---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionBackground from "../components/backgrounds/SectionBackground.astro";
import PageShell from "../components/layout/PageShell.astro";
import SiteOverlay from "../components/layout/SiteOverlay.astro";
import { projects } from "../data/projects";
import { withBase } from "../utils/base-path";

const mainProjects = projects.filter((project) => project.group === "main");
const prototypeProjects = projects.filter((project) => project.group === "prototype");
const projectGroups = [
  {
    eyebrow: "Projets principaux utilisables",
    title: "Quatre outils principaux, chacun avec son usage et sa progression.",
    items: mainProjects,
  },
  {
    eyebrow: "Prototype utilisable / expérimental",
    title: "Un terrain d’essai visuel, utilisable mais encore en phase prototype.",
    items: prototypeProjects,
  },
];
---

<BaseLayout
  title="Projets | Ph3yNyx.Studio"
  description="Vitrine des projets Ph3yNyx.Studio et de l’écosystème PH3YNYX.OS."
>
  <SectionBackground>
    <PageShell>
      <div class="section-heading">
        <p class="eyebrow">Projets</p>
        <h1 class="page-title">Écosystème de projets numériques en développement.</h1>
        <p class="section-intro">
          Ces projets sont des outils numériques en développement, construits
          par étapes selon des besoins réels. Ils ne sont pas présentés comme
          des produits finalisés, mais comme des outils utilisables, évolutifs
          et documentés.
        </p>
      </div>

      {projectGroups.map((group) => (
        <section class="projects-group">
          <div class="section-heading projects-group-heading">
            <p class="eyebrow">{group.eyebrow}</p>
            <h2>{group.title}</h2>
          </div>

          <div class="project-showcase-grid">
            {group.items.map((project) => {
              const projectHref = withBase(project.href);
              const overlayId = `project-${project.slug}`;
              const overlayTitleId = `${overlayId}-title`;

              return (
                <>
                  <article class="project-showcase-card glass-panel">
                    <div class="project-showcase-head">
                      <p class="eyebrow">Projet {project.id}</p>
                      {project.personal && (
                        <span class="project-personal-badge">Application personnelle</span>
                      )}
                    </div>

                    <h2>{project.title}</h2>
                    <p class="project-showcase-description">{project.description}</p>

                    <button
                      class="button button-secondary project-more-button"
                      type="button"
                      data-site-overlay-open={overlayId}
                      aria-haspopup="dialog"
                    >
                      Voir plus
                    </button>
                  </article>

                  <SiteOverlay
                    overlayId={overlayId}
                    titleId={overlayTitleId}
                    closeLabel={`Fermer les détails de ${project.title}`}
                    panelClass="project-overlay-panel"
                    contentClass="project-overlay-content"
                  >
                    <p class="eyebrow">Projet {project.id}</p>
                    <h2 id={overlayTitleId}>{project.title}</h2>
                    <span class="project-status">{project.status}</span>
                    <p class="project-overlay-summary">{project.tagline}</p>

                    <div class="square-card-tags">
                      {project.stack.map((item) => <span class="tag">{item}</span>)}
                    </div>

                    <div class="project-proof">
                      <p class="eyebrow">Preuve observable</p>
                      <p>{project.proof}</p>
                    </div>

                    <a class="button button-primary project-overlay-link" href={projectHref}>
                      Ouvrir la fiche projet
                    </a>
                  </SiteOverlay>
                </>
              );
            })}
          </div>
        </section>
      ))}
    </PageShell>
  </SectionBackground>
</BaseLayout>

<style>
  .projects-group {
    display: grid;
    gap: 1.5rem;
  }

  .projects-group + .projects-group {
    margin-top: 3rem;
  }

  .projects-group-heading {
    margin-bottom: 0;
  }

  .project-showcase-head {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .project-personal-badge {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 999px;
    background: var(--color-accent-surface-soft);
    color: var(--color-muted);
    font-size: 0.72rem;
  }

  .project-more-button,
  .project-overlay-link {
    width: fit-content;
  }

  .project-more-button {
    margin-top: auto;
  }

  .project-overlay-summary,
  .project-proof p:last-child {
    color: var(--color-muted);
  }

  :global(.project-overlay-panel) {
    width: min(100%, 680px);
  }

  :global(.project-overlay-content) {
    align-content: start;
  }

  @media (max-width: 768px) {
    .projects-group {
      gap: 1rem;
    }

    .projects-group + .projects-group {
      margin-top: 2.25rem;
    }

    .project-personal-badge {
      font-size: 0.68rem;
    }

    :global(.project-overlay-panel) {
      max-height: calc(100dvh - 1rem);
      padding: 1rem;
      overflow-y: auto;
    }
  }
</style>
