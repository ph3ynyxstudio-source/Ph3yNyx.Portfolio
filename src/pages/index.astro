---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import SectionBackground from "../components/backgrounds/SectionBackground.astro";
import AboutSection from "../components/sections/AboutSection.astro";

const internalBase = import.meta.env.DEV ? "/" : "/Ph3yNyx.Portfolio/";
const withBase = (path = "") => `${internalBase}${path}`;
---

<BaseLayout
  title="Ph3yNyx.Studio"
  description="Portfolio developpeur et studio d’outils numeriques local-first."
>
  <PageHero
    eyebrow="CRÉATEUR D’OUTILS NUMÉRIQUES · DÉVELOPPEUR WEB JUNIOR"
    title="Ph3yNyx."
    highlight="Studio"
    description="Je développe des interfaces, des prototypes et des outils numériques pratiques, structurés et utiles."
    primaryLabel="Voir mes projets"
    primaryHref={withBase("projets/")}
    secondaryLabel="Voir mon CV"
    secondaryHref={withBase("cv/")}
  />

  <div class="hero-body-accent" aria-hidden="true">
    <span class="hero-body-accent-line"></span>
  </div>

  <SectionBackground>
    <AboutSection />
  </SectionBackground>
</BaseLayout>
