---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionBackground from "../components/backgrounds/SectionBackground.astro";
import PageShell from "../components/layout/PageShell.astro";
import { assetPath, withBase } from "../utils/base-path";

const projectsHref = withBase("projets/");
const profilePhoto = assetPath("phey-rainville-profile.webp");
const githubHref = "https://github.com/ph3ynyxstudio-source";
const linkedInHref =
  "https://www.linkedin.com/in/phey-rainville?utm_source=share_via&utm_content=profile&utm_medium=member_android";
const studioEmail = "phey.rainville@hotmail.com";

const observableSkills = [
  "Clarification d’idées",
  "Structuration de projets",
  "Documentation",
  "Développement assisté par IA",
  "Test responsive / interface",
  "Organisation de contenu",
  "Apprentissage autonome",
  "Itération par besoins réels",
];

const toolGroups = [
  {
    title: "Environnement principal",
    items: ["VS Code", "Git", "GitHub", "npm", "pnpm"],
  },
  {
    title: "Frontend / interfaces",
    items: ["React", "Vite", "TypeScript", "HTML", "CSS", "Tailwind CSS"],
  },
  {
    title: "Mobile / exploration",
    items: ["Flutter", "Dart", "Android Studio"],
  },
  {
    title: "Cloud / backend exploré",
    items: ["Firebase", "Google Cloud"],
  },
  {
    title: "IA comme assistant",
    items: ["ChatGPT", "Codex", "Gemini", "Perplexity"],
  },
  {
    title: "Design / création visuelle",
    items: ["Inkscape", "Adobe Express", "Canva"],
  },
];

const keyProjects = [
  {
    title: "Chr0nosV3rs",
    description:
      "Outil local de suivi de sessions, documentation de progression, blocages, apprentissages et prochaines étapes.",
  },
  {
    title: "VespΣr",
    description:
      "Cockpit local de projets pour naviguer entre documents, sessions, contexte et outils de travail.",
  },
  {
    title: "Lun△rMood",
    description:
      "Application en reconstruction avec Flutter/Dart pour suivre les émotions, l’énergie et les cycles personnels.",
    details: [
      "Première version MVP réalisée avec React, Vite et TypeScript.",
      "Sauvegarde locale avec synchronisation optionnelle.",
    ],
  },
];
---

<BaseLayout
  title="CV numérique | Ph3yNyx.Studio"
  description="CV numérique compact de Phey Rainville."
>
  <SectionBackground>
    <PageShell class="cv-page">
      <div class="cv-stack">
        <section class="glass-panel cv-card cv-profile-card">
          <div class="cv-profile-head">
            <div class="cv-avatar-wrap">
              <img
                class="cv-avatar"
                src={profilePhoto}
                alt="Photo de profil de Phey Rainville"
                loading="eager"
              />
            </div>

            <div class="cv-profile-identity">
              <p class="eyebrow">CV numérique</p>
              <h1 class="page-title cv-name">Phey Rainville</h1>
              <p class="cv-role">
                Créateur d’outils numériques • Profil junior en développement
              </p>
              <div class="cv-meta-list">
                <p>Gatineau, Québec</p>
                <p>
                  <a class="cv-inline-link" href={`mailto:${studioEmail}`}>{studioEmail}</a>
                </p>
                <p>
                  <a class="cv-inline-link" href={linkedInHref} target="_blank" rel="noreferrer">
                    linkedin.com/in/phey-rainville
                  </a>
                </p>
                <p>
                  <a class="cv-inline-link" href={githubHref} target="_blank" rel="noreferrer">
                    github.com/ph3ynyxstudio-source
                  </a>
                </p>
              </div>
            </div>
          </div>

          <div class="cv-copy">
            <p>
              Je développe des projets personnels afin de concevoir des
              applications, structurer des idées et explorer différents domaines
              du développement logiciel.
            </p>
            <p>
              Curieux et polyvalent, je recherche une première expérience en
              entreprise afin de continuer à apprendre aux côtés d’une équipe et
              découvrir progressivement le domaine dans lequel je pourrai le
              mieux évoluer.
            </p>
            <p>
              Je développe mes projets par étapes : clarifier le besoin,
              construire un MVP, tester, documenter, puis améliorer
              progressivement.
            </p>
          </div>

          <a class="button button-secondary cv-project-link" href={projectsHref}>
            Découvrir mes projets
          </a>
        </section>

        <section class="glass-panel cv-card">
          <div class="cv-card-grid">
            <div class="cv-column">
              <div class="cv-section-head">
                <p class="eyebrow">Compétences observables</p>
              </div>

              <div class="cv-tag-list">
                {observableSkills.map((skill) => (
                  <span class="tag cv-tag">{skill}</span>
                ))}
              </div>

              <div class="cv-tools-stack">
                <article class="cv-tools-card">
                  <h3>Outils & environnement</h3>
                  <div class="cv-tools-groups">
                    {toolGroups.map((group) => (
                      <section class="cv-tool-group">
                        <h4>{group.title}</h4>
                        <p>{group.items.join(" · ")}</p>
                        {group.detail && <p class="cv-tool-detail">{group.detail}</p>}
                      </section>
                    ))}
                  </div>
                </article>
              </div>
            </div>

            <div class="cv-column">
              <div class="cv-section-head">
                <p class="eyebrow">Projets en développement</p>
              </div>

              <p class="cv-project-intro">
                Projets numériques en développement, utilisés pour apprendre,
                structurer des besoins réels et construire des outils évolutifs
                par itérations.
              </p>

              <div class="cv-project-list">
                {keyProjects.map((project) => (
                  <article class="cv-project-card">
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    {project.details?.map((detail) => (
                      <p class="cv-project-detail">{detail}</p>
                    ))}
                  </article>
                ))}
              </div>

              <a class="button button-secondary cv-project-link" href={projectsHref}>
                Découvrir mes projets
              </a>
            </div>
          </div>
        </section>

        <section class="glass-panel cv-card">
          <div class="cv-section-head">
            <p class="eyebrow">Parcours, formation & disponibilité</p>
          </div>

          <div class="cv-summary-grid">
            <article class="cv-summary-block">
              <h3>Formation</h3>
              <p>Formation IT prévue en octobre 2026.</p>
              <p>Place confirmée pour une prochaine cohorte.</p>
              <p>Équivalence de niveau secondaire (TENS).</p>
            </article>

            <article class="cv-summary-block">
              <h3>Expérience professionnelle transférable</h3>
              <div class="cv-experience-list">
                <p>
                  <span>Nasco — entretien d’immeubles, Gatineau</span>
                  Rigueur, autonomie, application de protocoles, maintien des standards.
                </p>
                <p>
                  <span>Flordeco – Rieux & fils, Gatineau</span>
                  Planification méthodique, exécution précise, respect des échéanciers.
                </p>
              </div>
            </article>

            <article class="cv-summary-block">
              <h3>Langues</h3>
              <p>Français — langue maternelle</p>
              <p>Anglais — compréhension fonctionnelle en lecture et à l’écoute</p>
            </article>

            <article class="cv-summary-block">
              <h3>Apprentissage & collaboration</h3>
              <p>
                Autodidacte, curieux et motivé par les projets numériques,
                j’apprends rapidement lorsque les notions sont reliées à des
                besoins concrets, des tests et une progression par étapes.
              </p>
              <p>
                J’ai aussi une facilité naturelle à aider les autres, clarifier
                les besoins et rendre l’information plus accessible dans un
                contexte d’équipe.
              </p>
            </article>

            <article class="cv-summary-block">
              <h3>Disponibilité / objectif réaliste</h3>
              <p>
                Je recherche une entrée progressive dans le milieu tech ou
                numérique, idéalement dans un cadre stable, flexible et
                compatible avec ma formation IT prévue en octobre 2026.
              </p>
            </article>
          </div>
        </section>
      </div>
    </PageShell>
  </SectionBackground>
</BaseLayout>

<style>
  .cv-page {
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .cv-stack {
    display: grid;
    gap: 1.25rem;
  }

  .cv-card {
    padding: 1.5rem;
  }

  .cv-profile-card {
    display: grid;
    gap: 1.35rem;
  }

  .cv-profile-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
  }

  .cv-avatar-wrap {
    width: 124px;
    height: 124px;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--color-accent-border-strong);
    background: var(--color-accent-surface-soft);
    flex-shrink: 0;
  }

  .cv-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cv-profile-identity {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .cv-name {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
  }

  .cv-role {
    color: var(--color-cyan-bright);
    font-weight: 600;
  }

  .cv-meta-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 1rem;
  }

  .cv-meta-list p,
  .cv-copy p,
  .cv-project-card p,
  .cv-summary-block p,
  .cv-skill-list {
    color: var(--color-muted);
    line-height: 1.65;
  }

  .cv-inline-link {
    color: var(--color-cyan-bright);
    text-decoration: none;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .cv-inline-link:hover,
  .cv-inline-link:focus-visible {
    text-decoration: underline;
  }

  .cv-copy {
    display: grid;
    gap: 0.9rem;
    max-width: 74ch;
  }

  .cv-card-grid,
  .cv-summary-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 1.25rem;
  }

  .cv-column,
  .cv-summary-block {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .cv-section-head {
    display: grid;
    gap: 0.45rem;
  }

  .cv-section-head h2,
  .cv-summary-block h3,
  .cv-project-card h3 {
    margin: 0;
    line-height: 1.2;
  }

  .cv-section-head h2 {
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
  }

  .cv-tools-card h3,
  .cv-summary-block h3,
  .cv-tool-group h4,
  .cv-project-card h3 {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .cv-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 0.9rem;
    align-items: flex-start;
  }

  .cv-tag {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    padding: 0.5rem 0.9rem;
    white-space: normal;
    overflow-wrap: break-word;
  }

  .cv-tools-stack {
    display: grid;
  }

  .cv-tools-card,
  .cv-summary-block {
    padding: 1rem;
    border: 1px solid var(--color-accent-border-soft);
    border-radius: 14px;
    background: var(--color-accent-surface-subtle);
  }

  .cv-tools-card {
    display: grid;
    gap: 0.9rem;
  }

  .cv-tools-groups {
    display: grid;
    gap: 0.85rem;
  }

  .cv-tool-group {
    display: grid;
    gap: 0.35rem;
  }

  .cv-tool-group h4 {
    margin: 0;
    font-size: 0.92rem;
  }

  .cv-tool-group p,
  .cv-project-intro,
  .cv-tool-detail {
    color: var(--color-muted);
    line-height: 1.6;
  }

  .cv-project-list {
    display: grid;
    gap: 0.9rem;
  }

  .cv-project-card {
    padding: 1rem;
    border: 1px solid var(--color-accent-border-soft);
    border-radius: 14px;
    background: var(--color-accent-surface-subtle);
  }

  .cv-project-card {
    display: grid;
    align-content: start;
    gap: 0.65rem;
  }

  .cv-project-detail {
    line-height: 1.6;
  }

  .cv-experience-list {
    display: grid;
    gap: 0.9rem;
  }

  .cv-experience-list span {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-text);
    font-weight: 600;
  }

  .cv-project-link {
    width: fit-content;
  }

  @media (max-width: 900px) {
    .cv-card-grid,
    .cv-summary-grid,
    .cv-meta-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .cv-page {
      padding-top: 1.5rem;
      padding-bottom: 4rem;
    }

    .cv-profile-head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .cv-card {
      padding: 1.2rem;
    }

    .cv-avatar-wrap {
      width: 108px;
      height: 108px;
    }
  }
</style>
